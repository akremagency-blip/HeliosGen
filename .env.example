# ── Quick start (guest mode) ──────────────────────────────────────────────────
# Set GUEST_MODE=true to run without Supabase or R2 — see .env.guest for details.
# Data is saved to data/guest-db.json; media is saved to public/generated/.
GUEST_MODE=
# KIE_API_KEY is only read in guest mode (production uses per-user keys via Settings UI).
KIE_API_KEY=

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set NEXT_PUBLIC_DEMO_MODE=true to replace the sign-in/signup modal with a
# prompt pointing visitors to the GitHub repo to self-host.
NEXT_PUBLIC_DEMO_MODE=

# ── Kie.ai ────────────────────────────────────────────────────────────────────
# No shared API key needed — each user saves their own key via the Settings UI.

# Public URL where kie.ai POSTs job completion results (webhook).
# Must be reachable from the internet.
# Local dev: use ngrok → ngrok http 3000
# Production: your deployed domain, e.g. https://your-app.vercel.app
CALLBACK_BASE_URL=

# Shared secret proving a POST to /api/callback really came from the provider.
# Optional: defaults to a value derived from KIE_API_KEY or the Supabase service
# role key. Set it to rotate the webhook secret on its own — openssl rand -hex 32
CALLBACK_SECRET=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Settings → API in your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Account ID: Cloudflare dashboard sidebar
R2_ACCOUNT_ID=
# API token: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL media is served from — enable public access on the bucket
# first. Use a custom domain: the r2.dev URL is rate-limited and Cloudflare
# documents it as development-only.
R2_PUBLIC_URL=

# ── S3-compatible storage instead of R2 (optional) ────────────────────────────
# Leave S3_ENDPOINT unset and Cloudflare R2 is used, built from R2_ACCOUNT_ID.
# Set it to run storage yourself — MinIO, Garage, Backblaze B2, Wasabi:
#   S3_ENDPOINT=http://127.0.0.1:9000
# The R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET_NAME / R2_PUBLIC_URL
# values above are reused as-is; only the endpoint changes.
S3_ENDPOINT=
# Path-style addressing turns on by itself for a custom endpoint (MinIO needs
# it). Set this only to override that.
S3_FORCE_PATH_STYLE=
# Defaults to "auto", which suits R2 and MinIO.
S3_REGION=

# ── Azure OpenAI (optional) ───────────────────────────────────────────────────
# Only needed if routing models through Azure AI Foundry instead of Kie.ai
AZURE_API_KEY=
